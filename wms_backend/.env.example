# =============================================
# WMS BACKEND — ENVIRONMENT VARIABLES
# =============================================
# ⚠️  IMPORTANT: Never commit this file to Git!
#     This file holds secret keys and passwords.
# =============================================

# --- Server Config ---
# The port this backend will run on locally
PORT=5000

# The environment mode: "development" or "production"
NODE_ENV=development

# --- Supabase Config ---
# 🔴 YOU NEED TO FILL THESE IN from your Supabase project dashboard!
# Step 1: Go to https://supabase.com and create a free account
# Step 2: Create a new project (name it: wms-backend)
# Step 3: Go to Project Settings → API
# Step 4: Copy "Project URL" into SUPABASE_URL below
# Step 5: Copy "service_role" secret key into SUPABASE_SERVICE_ROLE_KEY below
#         (Use service_role key for backend — it has full DB access)

SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- JWT Config ---
# This is a secret string used to sign login tokens.
# It can be anything — just make it long and hard to guess.
# Example: "my-super-secret-wms-key-2024-xqz"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# --- CORS Config ---
# The URL of your frontend so we allow it to talk to this backend
# While developing locally, Next.js runs on port 3000
FRONTEND_URL=http://localhost:3000
